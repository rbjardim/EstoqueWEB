@page
@model EstoqueWEB.Pages.LaudoModel
@{
    ViewData["Title"] = "Laudo";
}

<style>
    .laudo-container {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        padding: 50px;
        max-width: 3000px; 
        width: 90%;
        margin: 50px auto;
        height:1100px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .laudo-container:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
        }

        .laudo-container h1, .laudo-container h2 {
            color: #0096c7;
            margin-bottom: 20px;
            font-size: 2rem;
            font-weight: 700;
            text-align: center;
        }

        .laudo-container h1 {
            font-size: 2.5rem;
        }

        .laudo-container p {
            font-style: italic;
            color: #555;
            margin-bottom: 30px;
            font-size: 1.2rem;
        }

    .form-control {
        background-color: #f0f0f0;
        padding: 10px;
        border-radius: 4px;
        border: 1px solid #ddd;
        width: 100%;
        margin-bottom: 20px;
        font-size: 1rem;
    }

    .btn-custom {
        display: inline-block;
        background-color: #0096c7;
        color: #ffffff;
        padding: 14px 28px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 1.1rem;
        transition: background-color 0.3s ease, transform 0.3s ease;
        border: none;
        cursor: pointer;
    }

        .btn-custom:hover {
            background-color: #0077b6;
            transform: translateY(-3px);
        }

        .btn-custom:focus {
            outline: none;
        }

        .btn-custom:active {
            transform: translateY(1px);
        }


    .tox-editor-container {
        min-height: 100%;
        max-height: none;
    }

    .tox .tox-edit-area__iframe {
        height: 100%;
    }

</style>
<script>
    if (window.self !== window.top) {
        document.write('<style> footer { display: none; } </style>');
