<script src="https://cdn.tiny.cloud/1/fq4z68py3pnnfe2tmaf9pbxdj2apsoaham5usoerv0z9xhc3/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<script>
    tinymce.init({
        selector: '#word-editor',
        plugins: 'wordcount',
        toolbar: 'undo redo | formatselect | bold italic | alignleft aligncenter alignright alignjustify | outdent indent | wordcount',
        api_key: 'fq4z68py3pnnfe2tmaf9pbxdj2apsoaham5usoerv0z9xhc3',
        height: 900,
        setup: function (editor) {
            fetch('/Laudo/GetDocumentContent')
                .then(response => response.text())
                .then(data => {
                    editor.setContent(data);
                });
        }
    });

    document.getElementById('export-pdf').addEventListener('click', function () {
        var content = tinymce.get('word-editor').getContent();
        fetch('/Laudo/ExportToPdf', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ content: content })
        })
            .then(response => response.blob())
            .then(blob => {
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = "LaudoPreenchido.pdf";
                link.click();
            });
    });

</script>
